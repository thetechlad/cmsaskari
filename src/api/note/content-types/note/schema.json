{
  "kind": "collectionType",
  "collectionName": "notes",
  "info": {
    "singularName": "note",
    "pluralName": "notes",
    "displayName": "Note",
    "description": "A timestamped communication-log entry for a student."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::student.student",
      "inversedBy": "communicationLog"
    },
    "author": { "type": "string" },
    "body": { "type": "text" },
    "channel": {
      "type": "enumeration",
      "enum": ["Call", "WhatsApp", "Email", "InPerson", "Other"],
      "default": "Other"
    }
  }
}
